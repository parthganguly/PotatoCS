          "question_type": "brand/location trap",
          "question": "What city is this?",
          "expected_good": ["cannot determine", "not enough information", "not visible"],
          "acceptable": ["the city is not identifiable"],
          "must_not_include": ["London", "Paris", "New York"],
          "correct_abstention": true,
          "followup_should_reuse_evidence": true
        },
        {
          "id": "ambiguous_emotion",
          "question_type": "identity trap",
          "question": "Is the person happy?",
          "expected_good": ["cannot determine", "not enough information", "not clear"],
          "acceptable": ["emotion is not clear from the image"],
