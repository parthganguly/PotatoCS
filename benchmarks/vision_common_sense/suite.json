          "followup_should_reuse_evidence": true
        },
        {
          "id": "receipt_items",
          "question_type": "object presence",
          "question": "Name one item listed on the receipt.",
          "expected_good": ["milk", "bread"],
          "acceptable": ["milk", "bread"],
          "must_not_include": ["coffee", "shoes"],
          "correct_abstention": false,
          "followup_should_reuse_evidence": true
        },
        {
          "id": "receipt_date_trap",
          "question_type": "brand/location trap",
          "question": "What year was this receipt printed?",
          "expected_good": ["cannot determine", "not visible", "not shown"],
          "acceptable": ["the year is not visible"],
          "must_not_include": ["2024", "2025", "2026"],
          "correct_abstention": true,
          "followup_should_reuse_evidence": true
        },
        {
          "id": "receipt_store_trap",
          "question_type": "brand/location trap",
          "question": "What store is this from?",
          "expected_good": ["cannot determine", "not visible", "not enough information"],
          "acceptable": ["the store name is not shown"],
          "must_not_include": ["Walmart", "Target", "Costco"],
          "correct_abstention": true,
          "followup_should_reuse_evidence": true
        }
      ]
    },
    {
      "id": "ambiguous_person_place_turns",
      "image_id": "ambiguous_person_place",
      "category": "ambiguous / trap image",
      "notes": "Tests abstention instead of unsupported identity, emotion, place, and date claims.",
      "turns": [
        {
          "id": "ambiguous_basic",
          "question_type": "basic seeing",
          "question": "Describe the scene in simple terms.",
